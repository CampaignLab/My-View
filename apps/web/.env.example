# Server only. Never put these in the extension or use NEXT_PUBLIC_/VITE_ prefixes.
CLERK_SECRET_KEY=
DATABASE_URL=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Public key from the same Clerk application used by the extension.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
# Comma-separated explicit origins, no wildcard. Add the unpacked extension ID.
APP_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,chrome-extension://YOUR_EXTENSION_ID
# false keeps Facebook text out of Neon; only capture metadata is persisted.
STORE_CAPTURED_POST_TEXT=false
