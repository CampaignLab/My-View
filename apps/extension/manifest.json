{
  "manifest_version":3, "name":"My View", "version":"0.1.0",
  "description":"Join Facebook conversations in your own words. Review and publish yourself.",
  "minimum_chrome_version":"116",
  "permissions":["activeTab","scripting","storage","contextMenus","sidePanel","clipboardWrite"],
  "host_permissions":["http://localhost/*"],
  "action":{"default_title":"Open My View"},
  "background":{"service_worker":"background.js","type":"module"},
  "side_panel":{"default_path":"sidepanel.html"},
  "content_security_policy":{"extension_pages":"script-src 'self'; object-src 'self'"}
}
